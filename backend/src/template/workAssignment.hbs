<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>ใบมอบหมายงาน - {{documentNo}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'TH Sarabun New', 'Sarabun', 'Tahoma', Arial, sans-serif;
      font-size: 14px;
      color: #000;
      background: white;
    }

    .page {
      width: 210mm;
      height: 297mm;
      margin: 0 auto;
      padding: 10mm 12mm 8mm 12mm;
      background: white;
      display: flex;
      flex-direction: column;
    }

    @media print {
      html, body { width: 210mm; margin: 0; padding: 0; }
    }

    /* ─── Header ─── */
    .header {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .logo-wrap { flex: 0 0 auto; width: 100px; }
    .logo-wrap img { width: 100px; height: auto; display: block; }
    .title-wrap { flex: 1; text-align: center; }
    .form-title {
      font-size: 15px;
      font-weight: bold;
      color: #1a3c6e;
      line-height: 1.3;
      white-space: nowrap;
    }
    .form-subtitle { font-size: 12px; color: #444; margin-top: 2px; }
    .docno-wrap {
      flex: 0 0 auto;
      width: 155px;
      text-align: right;
      font-size: 12.5px;
      line-height: 2;
    }
    .docno-wrap strong { color: #1a3c6e; }

    .divider {
      border-top: 2px solid #1a3c6e;
      margin: 6px 0 8px 0;
      flex-shrink: 0;
    }
    .divider-thin {
      border-top: 1px solid #aaa;
      margin: 6px 0;
      flex-shrink: 0;
    }

    /* ─── Section title ─── */
    .section-title {
      font-weight: bold;
      font-size: 13.5px;
      margin-bottom: 5px;
    }

    /* ─── Fields ─── */
    .field-row {
      display: flex;
      align-items: flex-end;
      margin-bottom: 6px;
    }
    .field-label {
      white-space: nowrap;
      font-weight: bold;
      padding-right: 5px;
      flex-shrink: 0;
    }
    .field-value {
      flex: 1;
      border-bottom: 1px dotted #555;
      min-height: 21px;
      padding-bottom: 1px;
      padding-left: 3px;
    }
    .dotted-line {
      border-bottom: 1px dotted #555;
      min-height: 21px;
      margin-bottom: 6px;
      padding-left: 3px;
    }

    .row-group {
      display: flex;
      gap: 10px;
      margin-bottom: 6px;
    }
    .row-group .field-row { flex: 1; margin-bottom: 0; }

    /* ─── Detail box ─── */
    .detail-section {
      border: 1px solid #888;
      padding: 6px 9px;
      margin-bottom: 8px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .detail-content {
      white-space: pre-wrap;
      flex: 1;
      font-size: 13.5px;
    }
    .detail-lines { flex: 1; display: flex; flex-direction: column; gap: 0; }
    .detail-line {
      flex: 1;
      border-bottom: 1px dotted #555;
      min-height: 22px;
    }

    /* ─── Two-column table ─── */
    .two-col-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #888;
      margin-bottom: 8px;
      flex-shrink: 0;
    }
    .two-col-table td {
      padding: 6px 10px;
      vertical-align: top;
      width: 50%;
    }
    .two-col-table td:first-child { border-right: 1px solid #888; }
    .col-header {
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 5px;
      padding-bottom: 3px;
      border-bottom: 1px solid #ccc;
    }
    .cb-row {
      display: flex;
      align-items: center;
      margin-bottom: 4px;
      font-size: 13.5px;
    }
    .cb { font-size: 15px; margin-right: 6px; flex-shrink: 0; line-height: 1; }
    .cb-other {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 3px;
    }
    .cb-other-line {
      flex: 1;
      border-bottom: 1px dotted #555;
      min-height: 18px;
      font-size: 13px;
    }

    /* ─── Schedule ─── */
    .schedule-section {
      border: 1px solid #888;
      padding: 6px 10px;
      margin-bottom: 8px;
      flex-shrink: 0;
    }
    .count-row {
      display: flex;
      gap: 16px;
      margin-bottom: 6px;
    }
    .count-item {
      display: flex;
      align-items: flex-end;
      gap: 4px;
    }
    .count-box {
      border-bottom: 1px dotted #555;
      min-width: 44px;
      text-align: center;
      min-height: 21px;
      padding: 0 4px;
    }
    .count-unit { font-size: 13px; }
    .sched-grid {
      display: grid;
      grid-template-columns: auto 1fr auto 1fr;
      gap: 5px 10px;
      align-items: end;
    }
    .sched-label { font-weight: bold; white-space: nowrap; }
    .sched-value { border-bottom: 1px dotted #555; min-height: 21px; padding-left: 3px; }

    /* ─── Notes ─── */
    .notes-section {
      flex-shrink: 0;
      margin-bottom: 6px;
    }

    /* ─── Signature ─── */
    .sig-section {
      border-top: 2px solid #1a3c6e;
      display: flex;
      flex-shrink: 0;
      margin-top: 4px;
    }
    .sig-cell {
      flex: 1;
      text-align: center;
      padding: 8px 8px 6px 8px;
    }
    .sig-cell:not(:last-child) { border-right: 1px solid #888; }
    .sig-role {
      font-weight: bold;
      font-size: 15px;
      color: #1a3c6e;
      margin-bottom: 6px;
    }
    /* Fixed-height area — empty dotted line when unsigned, image when signed */
    .sig-area {
      height: 62px;
      border-bottom: 1px dotted #555;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 4px auto;
      width: 85%;
    }
    .sig-img {
      max-height: 58px;
      max-width: 100%;
      object-fit: contain;
      display: block;
    }
    .sig-bracket {
      font-size: 13px;
      color: #333;
      margin-bottom: 4px;
    }
    .sig-date {
      font-size: 11.5px;
      color: #444;
    }

    /* ─── Footer ─── */
    .footer-doc {
      text-align: right;
      font-size: 10px;
      color: #bbb;
      margin-top: 3px;
      flex-shrink: 0;
    }

    /* ─── Sections wrapper that fills remaining space ─── */
    .body-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ═══ HEADER ═══ -->
  <div class="header">
    <div class="logo-wrap">
      {{#if logoBase64}}
        <img src="{{logoBase64}}" alt="ENTECH SI">
      {{else}}
        <div style="font-size:22px;font-weight:bold;">
          <span style="color:#1E88E5;">ENTECH</span><span style="color:#FF9800;">SI</span>
        </div>
      {{/if}}
    </div>
    <div class="title-wrap">
      <div class="form-title">ใบมอบหมายงานทดสอบและสอบเทียบนอกสถานที่</div>
      <div class="form-subtitle">Work Assignment for Testing and Calibration Outside Premises</div>
    </div>
    <div class="docno-wrap">
      <div>เลขที่เอกสาร : <strong>{{documentNo}}</strong></div>
      <div>เลขที่ใบสั่งขาย : {{#if receivingNo}}<strong>{{receivingNo}}</strong>{{else}}___________{{/if}}</div>
    </div>
  </div>
  <div class="divider"></div>

  <!-- ═══ BODY ═══ -->
  <div class="body-content">

    <!-- Customer Info -->
    <div class="field-row">
      <span class="field-label">ลูกค้า บริษัท / หน่วยงาน :</span>
      <span class="field-value">{{customerCompany}}</span>
    </div>
    <div class="field-row">
      <span class="field-label">ชื่อลูกค้าที่ติดต่อ :</span>
      <span class="field-value">{{contactName}}</span>
    </div>
    <div class="field-row">
      <span class="field-label">ที่อยู่ :</span>
      <span class="field-value">{{customerAddress}}</span>
    </div>
    <div class="row-group">
      <div class="field-row" style="flex:1.1;">
        <span class="field-label">โทรศัพท์ :</span>
        <span class="field-value">{{phone}}</span>
      </div>
      <div class="field-row" style="flex:1.1;">
        <span class="field-label">มือถือ :</span>
        <span class="field-value">{{mobile}}</span>
      </div>
      <div class="field-row" style="flex:1.5;">
        <span class="field-label">อีเมลล์ :</span>
        <span class="field-value">{{contactEmail}}</span>
      </div>
    </div>
    <div class="field-row" style="margin-bottom:3px;">
      <span class="field-label" style="font-size:13px;">ชื่อ / ที่อยู่ ที่ต้องการออกใบรับรองผลการสอบเทียบ (ภาษาอังกฤษ) หรือรายงานผลทดสอบ :</span>
    </div>
    <div class="dotted-line" style="margin-bottom:3px;">{{certificateAddressEN}}</div>
    <div class="dotted-line"></div>

    <div class="divider-thin"></div>

    <!-- Test Details — flex:1 so it expands to fill page -->
    <div class="detail-section">
      <div class="section-title">รายละเอียดในการทดสอบ / สอบเทียบ</div>
      {{#if testDetails}}
        <div class="detail-content">{{testDetails}}</div>
      {{else}}
        <div class="detail-lines">
          <div class="detail-line"></div>
          <div class="detail-line"></div>
          <div class="detail-line"></div>
          <div class="detail-line"></div>
          <div class="detail-line"></div>
        </div>
      {{/if}}
    </div>

    <!-- Safety + Training -->
    <table class="two-col-table">
      <tr>
        <td>
          <div class="col-header">รายการอุปกรณ์ป้องกันอันตราย</div>
          <div class="cb-row"><span class="cb">{{#if safety.shoes}}☑{{else}}☐{{/if}}</span>รองเท้านิรภัย</div>
          <div class="cb-row"><span class="cb">{{#if safety.helmet}}☑{{else}}☐{{/if}}</span>หมวกนิรภัย</div>
          <div class="cb-row"><span class="cb">{{#if safety.glasses}}☑{{else}}☐{{/if}}</span>แว่นตานิรภัย</div>
          <div class="cb-other">
            <span class="cb">{{#if safety.otherText}}☑{{else}}☐{{/if}}</span>
            <span style="white-space:nowrap;">อื่นๆ ระบุ :</span>
            <span class="cb-other-line">{{safety.otherText}}</span>
          </div>
        </td>
        <td>
          <div class="col-header">การฝึกอบรมความปลอดภัยก่อนเข้าทำงาน</div>
          <div class="cb-row"><span class="cb">{{#if safetyTrainingRequired}}☑{{else}}☐{{/if}}</span>ต้องการ</div>
          <div class="cb-row"><span class="cb">{{#if safetyTrainingNotRequired}}☑{{else}}☐{{/if}}</span>ไม่ต้องการ</div>
        </td>
      </tr>
    </table>

    <!-- Workplace -->
    <table class="two-col-table">
      <tr>
        <td colspan="2" style="border-bottom:1px solid #888; padding:5px 10px;">
          <strong>ลักษณะหน้างาน</strong>
        </td>
      </tr>
      <tr>
        <td>
          <div class="col-header">ในอาคาร</div>
          <div class="cb-row"><span class="cb">{{#if workplace.production}}☑{{else}}☐{{/if}}</span>ในสายการผลิต</div>
          <div class="cb-row"><span class="cb">{{#if workplace.lab}}☑{{else}}☐{{/if}}</span>ในห้องปฏิบัติการ</div>
          <div class="cb-other">
            <span class="cb">{{#if workplace.indoorOther}}☑{{else}}☐{{/if}}</span>
            <span style="white-space:nowrap;">อื่นๆ ระบุ :</span>
            <span class="cb-other-line">{{workplace.indoorOther}}</span>
          </div>
        </td>
        <td>
          <div class="col-header">นอกอาคาร</div>
          <div class="cb-row"><span class="cb">{{#if workplace.outdoor}}☑{{else}}☐{{/if}}</span>ในเขตพื้นที่ปกติ</div>
          <div class="cb-row"><span class="cb">{{#if workplace.outdoorHazardous}}☑{{else}}☐{{/if}}</span>ในเขตพื้นที่อันตราย</div>
        </td>
      </tr>
    </table>

    <!-- Schedule -->
    <div class="schedule-section">
      <div class="count-row">
        <div class="count-item">
          <span class="field-label">จำนวนเจ้าหน้าที่ปฏิบัติงาน :</span>
          <span class="count-box">{{staffCount}}</span>
          <span class="count-unit">คน</span>
        </div>
        <div class="count-item" style="margin-left:24px;">
          <span class="field-label">ระยะเวลาในการปฏิบัติงาน :</span>
          <span class="count-box">{{workDays}}</span>
          <span class="count-unit">วัน</span>
        </div>
      </div>
      <div class="sched-grid">
        <span class="sched-label">วันที่นัดหมาย :</span>
        <span class="sched-value">{{appointmentDateFormatted}}</span>
        <span class="sched-label">เวลา :</span>
        <span class="sched-value">{{appointmentTime}}</span>
        <span class="sched-label" style="grid-column:1;">สถานที่ :</span>
        <span class="sched-value" style="grid-column:2/5;">{{appointmentPlace}}</span>
      </div>
    </div>

    <!-- Notes -->
    <div class="notes-section">
      <div class="field-row" style="margin-bottom:4px;">
        <span class="field-label">หมายเหตุ :</span>
        <span class="field-value">{{notes}}</span>
      </div>
      <div class="dotted-line" style="margin-bottom:0;"></div>
    </div>

  </div><!-- /body-content -->

  <!-- ═══ SIGNATURES ═══ -->
  <div class="sig-section">
    <div class="sig-cell">
      <div class="sig-role">ผู้มอบหมาย</div>
      <div class="sig-area">
        {{#if assignedToSig}}<img src="{{assignedToSig}}" class="sig-img" />{{/if}}
      </div>
      <div class="sig-bracket">
        {{#if assignedTo}}({{assignedTo}}){{else}}(..........................................){{/if}}
      </div>
      <div class="sig-date">
        {{#if assignedToSignedAt}}{{assignedToSignedAt}}{{else}}วันที่ .......... เดือน ......................... พ.ศ. ..........{{/if}}
      </div>
    </div>
    <div class="sig-cell">
      <div class="sig-role">ผู้อนุมัติ</div>
      <div class="sig-area">
        {{#if reviewedBySig}}<img src="{{reviewedBySig}}" class="sig-img" />{{/if}}
      </div>
      <div class="sig-bracket">
        {{#if reviewedBy}}({{reviewedBy}}){{else}}(..........................................){{/if}}
      </div>
      <div class="sig-date">
        {{#if reviewedBySignedAt}}{{reviewedBySignedAt}}{{else}}วันที่ .......... เดือน ......................... พ.ศ. ..........{{/if}}
      </div>
    </div>
    <div class="sig-cell">
      <div class="sig-role">ผู้รับงาน</div>
      <div class="sig-area">
        {{#if receivedBySig}}<img src="{{receivedBySig}}" class="sig-img" />{{/if}}
      </div>
      <div class="sig-bracket">
        {{#if receivedBy}}({{receivedBy}}){{else}}(..........................................){{/if}}
      </div>
      <div class="sig-date">
        {{#if receivedBySignedAt}}{{receivedBySignedAt}}{{else}}วันที่ .......... เดือน ......................... พ.ศ. ..........{{/if}}
      </div>
    </div>
  </div>

  <div class="footer-doc">FM-CAL-005-01</div>

</div>
</body>
</html>
